<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. Background Track Gauge Arc (270 degree sweep) -->
    <path
        android:pathData="M 36.32,71.68 A 25,25 0 1,1 71.68,71.68"
        android:strokeWidth="4.5"
        android:strokeColor="#1E2B45"
        android:strokeLineCap="round" />

    <!-- 2. Active Speed Gradient Arc -->
    <path
        android:pathData="M 36.32,71.68 A 25,25 0 1,1 75.65,41.50"
        android:strokeWidth="4.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="36"
                android:startY="72"
                android:endX="76"
                android:endY="41"
                android:type="linear">
                <item android:offset="0.0" android:color="#00E5FF" />
                <item android:offset="0.5" android:color="#00F2FE" />
                <item android:offset="1.0" android:color="#4FACFE" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3. Redline / Warning Arc Zone -->
    <path
        android:pathData="M 78.15,60.47 A 25,25 0 0,1 71.68,71.68"
        android:strokeWidth="4.5"
        android:strokeColor="#FF1744"
        android:strokeLineCap="round" />

    <!-- 4. Radial Tick Marks -->
    <!-- Tick 135 deg (Active Cyan) -->
    <path
        android:pathData="M 41.63,66.37 L 38.80,69.20"
        android:strokeWidth="2.0"
        android:strokeColor="#00F2FE"
        android:strokeLineCap="round" />

    <!-- Tick 180 deg (Active Cyan) -->
    <path
        android:pathData="M 36.5,54.0 L 32.5,54.0"
        android:strokeWidth="2.0"
        android:strokeColor="#00F2FE"
        android:strokeLineCap="round" />

    <!-- Tick 225 deg (Active Cyan) -->
    <path
        android:pathData="M 41.63,41.63 L 38.80,38.80"
        android:strokeWidth="2.0"
        android:strokeColor="#00F2FE"
        android:strokeLineCap="round" />

    <!-- Tick 270 deg (Top - Active Electric Blue) -->
    <path
        android:pathData="M 54.0,36.5 L 54.0,32.5"
        android:strokeWidth="2.2"
        android:strokeColor="#4FACFE"
        android:strokeLineCap="round" />

    <!-- Tick 315 deg (Active Electric Blue) -->
    <path
        android:pathData="M 66.37,41.63 L 69.20,38.80"
        android:strokeWidth="2.0"
        android:strokeColor="#4FACFE"
        android:strokeLineCap="round" />

    <!-- Tick 0 deg (Redline Danger) -->
    <path
        android:pathData="M 71.5,54.0 L 75.5,54.0"
        android:strokeWidth="2.0"
        android:strokeColor="#FF1744"
        android:strokeLineCap="round" />

    <!-- Tick 45 deg (Redline Danger) -->
    <path
        android:pathData="M 66.37,66.37 L 69.20,69.20"
        android:strokeWidth="2.0"
        android:strokeColor="#FF1744"
        android:strokeLineCap="round" />

    <!-- 5. Illuminated Tapered Speed Needle -->
    <path
        android:pathData="M 73.92,42.50 L 55.25,56.17 L 50.53,56.00 L 52.75,51.83 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="51"
                android:startY="56"
                android:endX="74"
                android:endY="42"
                android:type="linear">
                <item android:offset="0.0" android:color="#00B4D8" />
                <item android:offset="0.7" android:color="#00F2FE" />
                <item android:offset="1.0" android:color="#FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 6. Metallic Center Pivot Hub -->
    <path
        android:pathData="M 54,54 m -5.5,0 a 5.5,5.5 0 1,1 11,0 a 5.5,5.5 0 1,1 -11,0"
        android:fillColor="#0D1321"
        android:strokeWidth="1.2"
        android:strokeColor="#00F2FE" />

    <!-- Center White Highlight Dot -->
    <path
        android:pathData="M 54,54 m -2.2,0 a 2.2,2.2 0 1,1 4.4,0 a 2.2,2.2 0 1,1 -4.4,0"
        android:fillColor="#FFFFFF" />

    <!-- 7. Minimal Speed Indicator Chevrons at Bottom -->
    <path
        android:pathData="M 47.5,76.5 L 51.5,79.5 L 47.5,82.5"
        android:strokeWidth="1.5"
        android:strokeColor="#00F2FE"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <path
        android:pathData="M 53.5,76.5 L 57.5,79.5 L 53.5,82.5"
        android:strokeWidth="1.5"
        android:strokeColor="#4FACFE"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <path
        android:pathData="M 59.5,76.5 L 63.5,79.5 L 59.5,82.5"
        android:strokeWidth="1.5"
        android:strokeColor="#FF1744"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
